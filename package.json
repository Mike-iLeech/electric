{
  "name": "electriccad-easy",
  "version": "32.6.0",
  "description": "ElectricCAD Easy — конструктор временных электросетей",
  "author": "Mike-iLeech",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "build": "node build.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "node server.cjs",
    "desktop:start": "pnpm build && electron .",
    "desktop:dir": "pnpm build && electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "desktop:build": "pnpm build && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "desktop:release": "node scripts/signed-release.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "^26.1.0",
    "jspdf": "4.2.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
